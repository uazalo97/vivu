# Copy file này thành .env và điền giá trị thật (.env đã gitignore)

# ── LLM + Embedding (Single OpenAI key — unified) ─────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Deprecated (fallback, không cần set nếu đã có OPENAI_* ở trên)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_EMBED_MODEL=text-embedding-3-small

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Cloud hoặc local (khớp docker-compose.yml)
POSTGRES_URL=postgresql+asyncpg://user:pass@host:5432/dbname
PG_DSN=postgresql://user:pass@host:5432/dbname

# ── Redis (Upstash serverless — session store + cache) ─────────────────
# Option A: Upstash (serverless, TLS, free tier 10K cmd/ngày)
# 1. Tạo Upstash database region Singapore
# 2. Copy "Redis Connect" URL từ Upstash console → paste vào REDIS_URL
UPSTASH_REDIS_REST_URL=https://<name>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
REDIS_URL=rediss://default:<token>@<name>-<id>.upstash.io:6379
# Option B: Local (docker-compose)
# REDIS_URL=redis://localhost:6379/0

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vivu_specs

# ── Embedding (đồng bộ với OPENAI_EMBED_MODEL) ─────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small  # alias của OPENAI_EMBED_MODEL
EMBEDDING_DIM=1536

# ── Rerank (Cohere) ─────────────────────────────────────────────────────
RERANK_ENABLED=true
RERANK_MODEL=cohere
RERANK_TOP_K=20
COHERE_API_KEY=

# ── LangSmith (optional — cho LangGraph Studio tracing) ─────────────────
# Lấy free key tại https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true

# ── Cache & Rate Limit ────────────────────────────────────────────────
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
